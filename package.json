{
  "name": "svarog-center",
  "version": "3.6.0",
  "description": "SVAROG TEAM Command Center — замовлення, склад, фінанси, команда, доставка, аналітика",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win -p always",
    "dist:mac": "electron-builder --mac -p always",
    "dist:all": "electron-builder --win --mac -p always",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "build:win": "electron-builder --win -p never",
    "build:mac": "electron-builder --mac -p never",
    "release:patch": "npm version patch --no-git-tag-version && node -e \"const v=require('./package.json').version;console.log('\\nГотово. Тепер:\\n  git add package.json\\n  git commit -m \\\"Release v'+v+'\\\"\\n  git tag v'+v+'\\n  git push origin main --tags\\n')\"",
    "release:minor": "npm version minor --no-git-tag-version && node -e \"const v=require('./package.json').version;console.log('\\nГотово. Тепер:\\n  git add package.json\\n  git commit -m \\\"Release v'+v+'\\\"\\n  git tag v'+v+'\\n  git push origin main --tags\\n')\""
  },
  "keywords": [
    "svarog",
    "electron",
    "telegram",
    "command-center"
  ],
  "author": "SVAROG TEAM",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.1.4"
  },
  "devDependencies": {
    "electron": "^26.6.10",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.svarog.center",
    "productName": "SvarogCommandCenter",
    "copyright": "Copyright © 2026 SVAROG TEAM",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "blazhilinvladislav33-debug",
      "repo": "Svarog-Center",
      "private": false,
      "releaseType": "release"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "10.13.0"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "installer-assets/sidebar.png",
      "installerHeader": "installer-assets/header.png",
      "uninstallerSidebar": "installer-assets/sidebar.png",
      "shortcutName": "Svarog CommandCenter",
      "uninstallDisplayName": "Svarog CommandCenter (Видалити)",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "displayLanguageSelector": false
    }
  }
}